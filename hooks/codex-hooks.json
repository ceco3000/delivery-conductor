{
  "description": "Delivery Conductor triggers on the Chinese entry phrase and reminds the agent about the current gate at session start.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/hook_user_prompt.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/scripts/hook_user_prompt.py\""
          }
        ],
        "description": "Route a 编码总控 message and inject the mandatory conductor workflow",
        "id": "prompt:entry"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/guard_tool.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/scripts/guard_tool.py\""
          }
        ],
        "description": "Deny file edits and unclassified commands while a human approval gate is pending",
        "id": "pretool:approval-gate"
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/hook_session_start.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/scripts/hook_session_start.py\""
          }
        ],
        "description": "Report the current delivery phase and next required gate",
        "id": "session:start"
      }
    ]
  }
}
